<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.gimnasiouq.gimnasioapp.viewcontroller.CrudEntrenadorViewController">
    <children>
        <SplitPane dividerPositions="0.5" orientation="VERTICAL" prefHeight="600.0" prefWidth="900.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <!-- FORMULARIO SUPERIOR -->
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="296.0" prefWidth="898.0">
                    <children>
                        <Label layoutX="46.0" layoutY="48.0" prefHeight="25.0" prefWidth="98.0" text="Identificación:" />
                        <TextField fx:id="txtIdentificacion" layoutX="144.0" layoutY="48.0" prefWidth="200.0" />
                        
                        <Label layoutX="46.0" layoutY="100.0" prefHeight="25.0" prefWidth="54.0" text="Nombre:" />
                        <TextField fx:id="txtNombre" layoutX="144.0" layoutY="100.0" prefWidth="200.0" />
                        
                        <Label layoutX="46.0" layoutY="148.0" prefHeight="25.0" prefWidth="54.0" text="Teléfono:" />
                        <TextField fx:id="txtTelefono" layoutX="144.0" layoutY="148.0" prefWidth="200.0" />
                        
                        <Label layoutX="400.0" layoutY="48.0" prefHeight="25.0" prefWidth="54.0" text="Correo:" />
                        <TextField fx:id="txtCorreo" layoutX="480.0" layoutY="48.0" prefWidth="200.0" />
                        
                        <Label layoutX="400.0" layoutY="100.0" prefHeight="25.0" prefWidth="89.0" text="Sueldo:" />
                        <TextField fx:id="txtSueldo" layoutX="480.0" layoutY="100.0" prefWidth="150.0" />
                        
                        <Label layoutX="400.0" layoutY="148.0" prefHeight="25.0" prefWidth="89.0" text="Disponible:" />
                        <CheckBox fx:id="checkDisponible" layoutX="480.0" layoutY="148.0" selected="true" />

                        <!-- BOTONES -->
                        <Button fx:id="btnNuevo" layoutX="150.0" layoutY="220.0" onAction="#onActionNuevo" prefWidth="120.0" text="Nuevo" />
                        <Button fx:id="btnAgregar" layoutX="300.0" layoutY="220.0" onAction="#onActionAgregar" prefWidth="120.0" text="Agregar" />
                        <Button fx:id="btnActualizar" layoutX="450.0" layoutY="220.0" onAction="#onActionActualizar" prefWidth="120.0" text="Actualizar" />
                        <Button fx:id="btnEliminar" layoutX="600.0" layoutY="220.0" onAction="#onActionEliminar" prefWidth="120.0" text="Eliminar" />
                    </children>
                </AnchorPane>

                <!-- TABLA INFERIOR -->
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="296.0" prefWidth="898.0">
                    <children>
                        <TableView fx:id="tableEntrenador" layoutX="14.0" layoutY="14.0" prefHeight="268.0" prefWidth="872.0" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="14.0">
                            <columns>
                                <TableColumn fx:id="tcIdentificacion" prefWidth="120.0" text="Identificación" />
                                <TableColumn fx:id="tcNombre" prefWidth="180.0" text="Nombre" />
                                <TableColumn fx:id="tcTelefono" prefWidth="120.0" text="Teléfono" />
                                <TableColumn fx:id="tcCorreo" prefWidth="180.0" text="Correo" />
                                <TableColumn fx:id="tcSueldo" prefWidth="120.0" text="Sueldo" />
                                <TableColumn fx:id="tcDisponible" prefWidth="100.0" text="Disponible" />
                            </columns>
                        </TableView>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>
