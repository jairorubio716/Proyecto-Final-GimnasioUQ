<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.gimnasiouq.gimnasioapp.viewcontroller.GestionPersonalViewController">
    <children>
        <SplitPane dividerPositions="0.45" orientation="VERTICAL" prefHeight="600.0" prefWidth="900.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="266.0" prefWidth="898.0">
                    <children>
                        <Label layoutX="30.0" layoutY="20.0" text="Gestión de Personal del Sistema">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <GridPane hgap="10.0" layoutX="30.0" layoutY="60.0" prefWidth="840.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="120.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="280.0" />
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="120.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="280.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Nombre:" />
                                <TextField fx:id="txtNombre" GridPane.columnIndex="1" />

                                <Label text="Identificación:" GridPane.columnIndex="2" />
                                <TextField fx:id="txtIdentificacion" GridPane.columnIndex="3" />

                                <Label text="Correo:" GridPane.rowIndex="1" />
                                <TextField fx:id="txtCorreo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Contraseña:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <PasswordField fx:id="txtContrasena" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                <Label text="Rol:" GridPane.rowIndex="2" />
                                <ComboBox fx:id="comboRol" prefWidth="280.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            </children>
                        </GridPane>

                        <HBox alignment="CENTER" layoutX="30.0" layoutY="200.0" prefWidth="840.0" spacing="20.0">
                            <children>
                                <Button fx:id="btnNuevo" onAction="#onActionNuevo" prefWidth="120.0" text="Nuevo" />
                                <Button fx:id="btnAgregar" onAction="#onActionAgregar" prefWidth="120.0" text="Agregar" />
                                <Button fx:id="btnActualizar" onAction="#onActionActualizar" prefWidth="120.0" text="Actualizar" />
                                <Button fx:id="btnEliminar" onAction="#onActionEliminar" prefWidth="120.0" text="Eliminar" />
                            </children>
                        </HBox>
                    </children>
                </AnchorPane>

                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="329.0" prefWidth="898.0">
                    <children>
                        <TableView fx:id="tablePersonal" prefHeight="300.0" prefWidth="872.0" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="14.0">
                            <columns>
                                <TableColumn fx:id="tcNombre" prefWidth="200.0" text="Nombre" />
                                <TableColumn fx:id="tcIdentificacion" prefWidth="120.0" text="Identificación" />
                                <TableColumn fx:id="tcCorreo" prefWidth="200.0" text="Correo" />
                                <TableColumn fx:id="tcRol" prefWidth="100.0" text="Rol" />
                            </columns>
                        </TableView>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>
