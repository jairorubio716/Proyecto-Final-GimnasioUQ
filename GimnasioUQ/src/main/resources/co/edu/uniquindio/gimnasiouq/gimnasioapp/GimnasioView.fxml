<AnchorPane prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.gimnasiouq.gimnasioapp.viewcontroller.GimnasioViewController">
    <children>
        <TabPane fx:id="tabPanePrincipal" prefHeight="700.0" prefWidth="1200.0" tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <tabs>
                <Tab fx:id="tabControlAcceso" text="Control de Acceso">
                    <content>
                        <fx:include source="ControlAccesoView.fxml" />
                    </content>
                </Tab>
                <Tab fx:id="tabGestionUsuarios" text="Gestionar Usuarios">
                    <content>
                        <fx:include source="CrudUsuarioView.fxml" />
                    </content>
                </Tab>
                <Tab fx:id="tabGestionMembresias" text="Gestionar Membresías">
                    <content>
                        <fx:include source="MembresiaView.fxml" />
