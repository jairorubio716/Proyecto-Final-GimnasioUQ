                </Tab>
                <Tab fx:id="tabGestionEntrenadores" text="Gestionar Entrenadores">
                    <content>
                        <fx:include source="CrudEntrenadoresView.fxml" />
                    </content>
                </Tab>
                <Tab fx:id="tabGestionClases" text="Gestionar Clases">
                    <content>
                        <fx:include source="CrudClasesView.fxml" />
                    </content>
                </Tab>
                <Tab fx:id="tabReservas" text="Reservas de Clases">
                    <content>
                        <fx:include source="CrudReservaView.fxml" />
                    </content>
                </Tab>
                <Tab fx:id="tabReportes" text="Reportes">
                    <content>
                        <fx:include source="ReportesView.fxml" />
                    </content>
                </Tab>
                <Tab fx:id="tabReportesAdmin" text="Reportes Admin">
                    <content>
                        <fx:include source="ReportesAdminView.fxml" />
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
