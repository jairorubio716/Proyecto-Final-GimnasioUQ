<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.gimnasiouq.gimnasioapp.viewcontroller.CrudClaseViewController">
    <children>
        <SplitPane dividerPositions="0.5" orientation="VERTICAL" prefHeight="600.0" prefWidth="900.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <!-- FORMULARIO SUPERIOR -->
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="266.0" prefWidth="898.0">
                    <children>
                        <Label layoutX="30.0" layoutY="20.0" text="Gestión de Clases">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <GridPane hgap="10.0" layoutX="30.0" layoutY="60.0" prefWidth="840.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="120.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="280.0" />
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="120.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="280.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" /> <!-- Nueva fila para Hora Fin -->
                            </rowConstraints>
                            <children>
                                <Label text="Nombre de la Clase:" />
                                <TextField fx:id="txtNombreClase" GridPane.columnIndex="1" />
                                
                                <Label text="Día de la Semana:" GridPane.rowIndex="1" />
                                <ComboBox fx:id="comboDia" prefWidth="280.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                
                                <Label text="Cupo Máximo:" GridPane.rowIndex="2" />
                                <TextField fx:id="txtCupoMaximo" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Hora Inicio (HH:mm):" GridPane.columnIndex="2" />
                                <TextField fx:id="txtHorario" promptText="Ej: 08:00" GridPane.columnIndex="3" />
                                
                                <Label text="Hora Fin (HH:mm):" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <TextField fx:id="txtHoraFin" promptText="Ej: 09:00" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                
                                <Label text="Entrenador por Defecto:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                <ComboBox fx:id="comboEntrenadorDefecto" prefWidth="280.0" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                            </children>
                        </GridPane>
                        
                        <HBox alignment="CENTER" layoutX="30.0" layoutY="240.0" prefWidth="840.0" spacing="20.0"> <!-- Ajustar layoutY -->
                            <children>
                                <Button fx:id="btnNuevo" onAction="#onActionNuevo" prefWidth="120.0" text="Nuevo" />
                                <Button fx:id="btnAgregar" onAction="#onActionAgregar" prefWidth="120.0" text="Agregar" />
                                <Button fx:id="btnActualizar" onAction="#onActionActualizar" prefWidth="120.0" text="Actualizar" />
                                <Button fx:id="btnEliminar" onAction="#onActionEliminar" prefWidth="120.0" text="Eliminar" />
                            </children>
                        </HBox>
                    </children>
                </AnchorPane>

                <!-- TABLA INFERIOR -->
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="329.0" prefWidth="898.0">
                    <children>
                        <TableView fx:id="tableClases" prefHeight="300.0" prefWidth="872.0" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="14.0">
                            <columns>
                                <TableColumn fx:id="tcNombre" prefWidth="150.0" text="Nombre" />
                                <TableColumn fx:id="tcDia" prefWidth="100.0" text="Día" />
                                <TableColumn fx:id="tcHorario" prefWidth="80.0" text="Inicio" /> <!-- Ajustar texto -->
                                <TableColumn fx:id="tcHoraFin" prefWidth="80.0" text="Fin" /> <!-- Nueva columna -->
                                <TableColumn fx:id="tcCupo" prefWidth="80.0" text="Cupo Máx." />
                                <TableColumn fx:id="tcEntrenador" prefWidth="150.0" text="Entrenador por Defecto" />
                            </columns>
                        </TableView>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>