<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.gimnasiouq.gimnasioapp.viewcontroller.CrudMembresiaViewController">

    <children>
        <SplitPane dividerPositions="0.45" orientation="VERTICAL" prefHeight="650.0" prefWidth="900.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <!-- FORMULARIO SUPERIOR -->
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="288.0" prefWidth="898.0">
                    <children>
                        <GridPane hgap="10" layoutX="50.0" layoutY="30.0" prefWidth="800.0" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="100.0" minWidth="10.0" prefWidth="80.0" />
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="250.0" minWidth="10.0" prefWidth="220.0" />
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="100.0" minWidth="10.0" prefWidth="80.0" />
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="250.0" minWidth="10.0" prefWidth="220.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Código:" />
                                <TextField fx:id="txtCodigo" editable="false" GridPane.columnIndex="1" />

                                <Label text="Usuario:" GridPane.rowIndex="1" />
                                <ComboBox fx:id="comboUsuario" prefWidth="250.0" promptText="Seleccione usuario" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Costo:" GridPane.rowIndex="2" />
                                <TextField fx:id="txtCosto" editable="false" style="-fx-background-color: #f0f0f0; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Tipo:" GridPane.columnIndex="2" />
                                <ComboBox fx:id="comboTipoMembresia" prefWidth="250.0" promptText="Seleccione tipo" GridPane.columnIndex="3" />

                                <Label text="Duración:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <ComboBox fx:id="comboDuracion" prefWidth="250.0" promptText="Seleccione duración" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                <Label text="Estado:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                <ComboBox fx:id="comboEstado" prefWidth="250.0" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                            </children>
                        </GridPane>

                        <!-- BOTONES -->
                        <HBox alignment="CENTER" layoutX="50.0" layoutY="200.0" prefWidth="800.0" spacing="20.0">
                            <children>
                                <Button fx:id="btnNuevo" onAction="#onActionNuevo" prefWidth="120.0" text="Nuevo" />
                                <Button fx:id="btnAgregar" onAction="#onActionAgregar" prefWidth="120.0" text="Agregar" />
                                <Button fx:id="btnActualizar" onAction="#onActionActualizar" prefWidth="120.0" text="Actualizar" />
                                <Button fx:id="btnEliminar" onAction="#onActionEliminar" prefWidth="120.0" text="Eliminar" />
                            </children>
                        </HBox>
                    </children>
                </AnchorPane>

                <!-- TABLA -->
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="352.0" prefWidth="898.0">
                    <children>
                        <TableView fx:id="tableMembresia" prefHeight="330.0" prefWidth="872.0" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="14.0">
                            <columns>
                                <TableColumn fx:id="tcCodigo" prefWidth="72.0" text="Código" />
                                <TableColumn fx:id="tcUsuario" prefWidth="85.0" text="Usuario" />
                                <TableColumn fx:id="tcTipo" prefWidth="90.0" text="Tipo" />
                                <TableColumn fx:id="tcDuracion" prefWidth="99.0" text="Duración" />
                                <TableColumn fx:id="tcCosto" prefWidth="82.0" text="Costo" />
                                <TableColumn fx:id="tcFechaInicio" prefWidth="87.0" text="Fecha Inicio" />
                                <TableColumn fx:id="tcFechaFin" prefWidth="172.0" text="Fecha Fin" />
                                <TableColumn fx:id="tcEstado" prefWidth="209.0" text="Estado" />
                            </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                        </TableView>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>
