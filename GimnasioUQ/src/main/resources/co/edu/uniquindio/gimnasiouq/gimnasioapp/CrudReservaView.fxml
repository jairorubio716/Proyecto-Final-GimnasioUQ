<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.gimnasiouq.gimnasioapp.viewcontroller.CrudReservaViewController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>

            <!-- TÍTULO -->
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="SISTEMA DE RESERVAS - CLASES GRUPALES" />

            <!-- SECCIÓN 1: SELECCIÓN DE USUARIO Y INFO MEMBRESÍA -->
            <HBox spacing="20.0">
                <!-- SELECTOR DE USUARIO -->
                <VBox prefWidth="400.0" spacing="8.0" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 10;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="SELECCIONAR USUARIO" />
                        <ComboBox fx:id="comboUsuario" prefWidth="380.0" />
                    </children>
                </VBox>

                <!-- INFORMACIÓN DE MEMBRESÍA -->
                <VBox prefWidth="400.0" spacing="8.0" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 10;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="INFORMACIÓN DE ACCESO" />
                        <HBox spacing="10.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Membresía:" />
                                <Label fx:id="lblTipoMembresia" style="-fx-font-weight: bold; -fx-text-fill: #e74c3c;" />
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Estado:" />
                                <Label fx:id="lblEstadoMembresia" style="-fx-font-weight: bold;" />
                            </children>
                        </HBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Áreas Permitidas:" />
                                <HBox spacing="15.0">
                                    <children>
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label fx:id="lblMaquinas" style="-fx-text-fill: #27ae60;" text="✅ Máquinas" />
                                                <Label fx:id="lblClases" style="-fx-text-fill: #e74c3c;" text="❌ Clases Grupales" />
                                                <Label fx:id="lblSpa" style="-fx-text-fill: #e74c3c;" text="❌ Área Spa" />
                                                <Label fx:id="lblEntrenador" style="-fx-text-fill: #e74c3c;" text="❌ Entrenador Personal" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </HBox>

            <!-- SECCIÓN 2: RESERVA DE CLASES (SOLO VISIBLE SI PUEDE RESERVAR) -->
            <VBox fx:id="panelReservaClases" spacing="10.0" style="-fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 15;">
                <children>
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2980b9;" text="RESERVAR CLASE GRUPAL" />
                    <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <children>
                            <VBox spacing="5.0">
                                <children>
                                    <Label text="Tipo de Clase:" />
                                    <ComboBox fx:id="comboTipoClase" prefWidth="200.0" />
                                </children>
                            </VBox>
                            <VBox spacing="5.0">
                                <children>
                                    <Label text="Fecha de Clase:" />
                                    <DatePicker fx:id="dateFechaClase" prefWidth="150.0" />
                                </children>
                            </VBox>
                            <VBox spacing="5.0">
                                <children>
                                    <Label text="Cupos Disponibles:" />
                                    <Label fx:id="lblCuposDisponibles" alignment="CENTER" prefWidth="80.0" style="-fx-border-color: #7f8c8d; -fx-padding: 8; -fx-font-weight: bold;" />
                                </children>
                            </VBox>
                            <VBox spacing="5.0">
                                <children>
                                    <Label text=" " />
                                    <Button fx:id="btnCrearReserva" onAction="#onActionCrearReserva" prefWidth="140.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Confirmar Reserva" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                    <!-- MENSAJE INFORMATIVO -->
                    <Label fx:id="lblMensajeReserva" style="-fx-text-fill: #e67e22; -fx-font-style: italic;" />
                </children>
            </VBox>

            <!-- SECCIÓN 3: TABLA DE RESERVAS ACTIVAS -->
            <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                <children>
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="RESERVAS DEL USUARIO" />
                    <TableView fx:id="tableReserva" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="tcCodigo" prefWidth="120.0" text="Código" />
                            <TableColumn fx:id="tcClase" prefWidth="150.0" text="Clase" />
                            <TableColumn fx:id="tcFechaClase" prefWidth="120.0" text="Fecha Clase" />
                            <TableColumn fx:id="tcFechaReserva" prefWidth="120.0" text="Fecha Reserva" />
                            <TableColumn fx:id="tcEstado" prefWidth="100.0" text="Estado" />
                        </columns>
                    </TableView>
                    <!-- BOTONES DE ACCIÓN PARA RESERVA SELECCIONADA -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <children>
                            <Button fx:id="btnCancelarReserva" onAction="#onActionCancelarReserva" prefWidth="120.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Cancelar Reserva" />
                            <Button fx:id="btnRegistrarAsistencia" onAction="#onActionRegistrarAsistencia" prefWidth="140.0" style="-fx-background-color: #f39c12; -fx-text-fill: white;" text="Registrar Asistencia" />
                        </children>
                    </HBox>
                </children>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
