<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.gimnasiouq.gimnasioapp.viewcontroller.CrudReservaViewController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="GESTIÓN DE RESERVAS" />

            <HBox spacing="20.0">
                <VBox prefWidth="400.0" spacing="8.0" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 10;">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="SELECCIONAR USUARIO" />
                    <ComboBox fx:id="comboUsuario" prefWidth="380.0" />
                </VBox>

                <VBox prefWidth="400.0" spacing="8.0" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 10;">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="INFORMACIÓN DE MEMBRESÍA" />
                    <HBox spacing="10.0">
                        <Label style="-fx-font-weight: bold;" text="Membresía:" />
                        <Label fx:id="lblTipoMembresia" style="-fx-font-weight: bold; -fx-text-fill: #e74c3c;" />
                    </HBox>
                    <HBox spacing="10.0">
                        <Label style="-fx-font-weight: bold;" text="Estado:" />
                        <Label fx:id="lblEstadoMembresia" style="-fx-font-weight: bold;" />
                    </HBox>
                </VBox>
            </HBox>

            <VBox fx:id="panelReservaClases" spacing="15.0" style="-fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 15;" managed="false" visible="false">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2980b9;" text="RESERVAR CLASE" />
                
                <HBox alignment="BOTTOM_LEFT" spacing="20.0">
                    <VBox spacing="5.0">
                        <Label text="Clase Grupal:" />
                        <ComboBox fx:id="comboClase" prefWidth="300.0" />
                    </VBox>
                    <VBox spacing="5.0">
                        <Label text="Fecha de la Clase:" />
                        <DatePicker fx:id="dateFechaClase" prefWidth="150.0" />
                    </VBox>
                    <VBox spacing="5.0">
                        <Label text="Cupos:" />
                        <Label fx:id="lblCuposDisponibles" alignment="CENTER" prefWidth="80.0" style="-fx-border-color: #7f8c8d; -fx-padding: 8; -fx-font-weight: bold;" />
                    </VBox>
                </HBox>

                <VBox fx:id="panelEntrenadorVip" spacing="5.0" managed="false" visible="false">
                    <Label text="Asignar Entrenador Personal (Beneficio VIP):" style="-fx-font-weight: bold; -fx-text-fill: #8e44ad;" />
                    <ComboBox fx:id="comboEntrenador" prefWidth="300.0" />
                </VBox>

                <Button fx:id="btnCrearReserva" onAction="#onActionCrearReserva" prefWidth="160.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Confirmar Reserva" />
            </VBox>

            <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="HISTORIAL DE RESERVAS DEL USUARIO" />
                <TableView fx:id="tableReserva" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="tcCodigo" prefWidth="120.0" text="Código" />
                        <TableColumn fx:id="tcClase" prefWidth="250.0" text="Clase" />
                        <TableColumn fx:id="tcFechaClase" prefWidth="120.0" text="Fecha Clase" />
                        <TableColumn fx:id="tcFechaReserva" prefWidth="120.0" text="Fecha Reserva" />
                        <TableColumn fx:id="tcEstado" prefWidth="100.0" text="Estado" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button fx:id="btnCancelarReserva" onAction="#onActionCancelarReserva" prefWidth="120.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Cancelar Reserva" />
                </HBox>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
