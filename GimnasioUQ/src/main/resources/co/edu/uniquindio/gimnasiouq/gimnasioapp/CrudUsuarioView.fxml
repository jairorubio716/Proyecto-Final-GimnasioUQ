<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/20.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.gimnasiouq.gimnasioapp.viewcontroller.CrudUsuarioViewController">

    <children>
        <SplitPane dividerPositions="0.5" layoutX="14.0" layoutY="14.0"
                   orientation="VERTICAL" prefHeight="572.0" prefWidth="772.0">

            <items>
                <!-- FORMULARIO SUPERIOR -->
                <AnchorPane prefHeight="300.0" prefWidth="770.0">
                    <children>
                        <!-- DATOS BÁSICOS -->
                        <Label layoutX="55.0" layoutY="33.0" text="Nombre:" />
                        <Label layoutX="410.0" layoutY="33.0" text="Identificación:" />
                        <Label layoutX="55.0" layoutY="78.0" text="Edad:" />
                        <Label layoutX="410.0" layoutY="78.0" text="Teléfono:" />
                        <Label layoutX="55.0" layoutY="123.0" text="Tipo Usuario:" />

                        <TextField fx:id="txtNombre" layoutX="122.0" layoutY="29.0"
                                   prefHeight="26.0" prefWidth="242.0"/>

                        <TextField fx:id="txtIdentificacion" layoutX="520.0" layoutY="29.0"
                                   prefHeight="26.0" prefWidth="182.0"/>

                        <TextField fx:id="txtEdad" layoutX="122.0" layoutY="74.0"
                                   prefHeight="26.0" prefWidth="242.0"/>

                        <TextField fx:id="txtTelefono" layoutX="520.0" layoutY="74.0"
                                   prefHeight="26.0" prefWidth="182.0"/>

                        <ComboBox fx:id="comboTipoUsuario" layoutX="160.0" layoutY="119.0"
                                  prefHeight="26.0" prefWidth="204.0"/>

                        <!-- BOTONES -->
                        <Button fx:id="btnNuevoUsuario" layoutX="80.0" layoutY="180.0"
                                prefHeight="26.0" prefWidth="133.0" text="Nuevo"
                                onAction="#onActionNuevoUsuario"/>

                        <Button fx:id="btnCrearUsuario" layoutX="316.0" layoutY="180.0"
                                prefHeight="26.0" prefWidth="133.0" text="Crear"
                                onAction="#onActionCrearUsuario"/>

                        <Button fx:id="btnActualizarUsuario" layoutX="524.0" layoutY="180.0"
                                prefHeight="26.0" prefWidth="133.0" text="Actualizar"
                                onAction="#onActionActualizarUsuario"/>

                        <Button fx:id="btnEliminarUsuario" layoutX="316.0" layoutY="220.0"
                                prefHeight="26.0" prefWidth="133.0" text="Eliminar"
                                onAction="#onActionEliminarUsuario" />

                        <!-- PANELES ESPECÍFICOS -->
                        <!-- Panel Estudiante -->
                        <AnchorPane fx:id="panelEstudiante" layoutX="55.0" layoutY="260.0"
                                    prefWidth="664.0" prefHeight="80.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;">
                            <children>
                                <Label layoutX="14.0" layoutY="14.0" text="Semestre:"/>
                                <TextField fx:id="txtSemestre" layoutX="85.0" layoutY="10.0" prefWidth="100.0"/>
                                <Label layoutX="200.0" layoutY="14.0" text="Programa:"/>
                                <TextField fx:id="txtPrograma" layoutX="265.0" layoutY="10.0" prefWidth="200.0"/>
                                <Label layoutX="14.0" layoutY="45.0" text="Estudiante" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            </children>
                        </AnchorPane>

                        <!-- Panel Trabajador -->
                        <AnchorPane fx:id="panelTrabajador" layoutX="55.0" layoutY="260.0"
                                    prefWidth="664.0" prefHeight="80.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;">
                            <children>
                                <Label layoutX="14.0" layoutY="14.0" text="Cargo:"/>
                                <TextField fx:id="txtCargo" layoutX="85.0" layoutY="10.0" prefWidth="300.0"/>
                                <Label layoutX="14.0" layoutY="45.0" text="Trabajador" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            </children>
                        </AnchorPane>

                        <!-- Panel Externo -->
                        <AnchorPane fx:id="panelExterno" layoutX="55.0" layoutY="260.0"
                                    prefWidth="664.0" prefHeight="80.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;">
                            <children>
                                <Label layoutX="14.0" layoutY="14.0" text="Institución:"/>
                                <TextField fx:id="txtInstitucion" layoutX="85.0" layoutY="10.0" prefWidth="300.0"/>
                                <Label layoutX="14.0" layoutY="45.0" text="Externo" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            </children>
                        </AnchorPane>

                    </children>
                </AnchorPane>

                <!-- TABLA INFERIOR -->
                <AnchorPane prefHeight="300.0" prefWidth="770.0">
                    <children>
                        <TableView fx:id="tableUsuario" layoutX="14.0" layoutY="14.0"
                                   prefHeight="272.0" prefWidth="742.0">
                            <columns>
                                <TableColumn fx:id="tcNombre" prefWidth="150.0" text="Nombre"/>
                                <TableColumn fx:id="tcIdentificacion" prefWidth="120.0" text="Identificación"/>
                                <TableColumn fx:id="tcEdad" prefWidth="80.0" text="Edad"/>
                                <TableColumn fx:id="tcTelefono" prefWidth="120.0" text="Teléfono"/>
                                <TableColumn fx:id="tcTipoUsuario" prefWidth="100.0" text="Tipo Usuario"/>
                                <TableColumn fx:id="tcDetalleEspecifico" prefWidth="150.0" text="Detalle Específico"/>
                            </columns>
                        </TableView>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>